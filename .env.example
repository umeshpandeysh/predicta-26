# PREDICTA SIH 2026 — Environment Configuration Template
# Copy this file to .env for local development

# ==============================================================================
# BACKEND-ONLY SECRETS (NEVER expose to frontend or commit to version control)
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY=your_backend_service_role_secret_key_here
PORT=8000
NODE_ENV=development

# ==============================================================================
# API AUTHENTICATION (required to enable admin login and signed JWT sessions)
# ==============================================================================
ADMIN_LOGIN_USER=your_admin_username_here
ADMIN_LOGIN_PASSWORD=your_strong_admin_password_here
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
OPERATOR_API_KEY=replace_with_a_random_operator_api_key
ADMIN_API_KEY=replace_with_a_random_admin_api_key
ALLOWED_ORIGIN=https://your-production-frontend.example

# ==============================================================================
# FRONTEND-SAFE PUBLIC CONFIGURATION (Safe for browser bundle)
# ==============================================================================
PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here
