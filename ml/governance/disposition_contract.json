{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_name": "predicta_disposition_contract",
  "contract_version": "1.1.0",
  "authority_level": "AUTHORITATIVE_GOVERNANCE_CONTRACT",
  "created_at": "2026-09-21T00:00:00Z",
  "disposition_taxonomy": [
    "ACCEPT",
    "REJECT",
    "HOLD",
    "RETEST",
    "ESCALATE"
  ],
  "reason_code_taxonomy": [
    "FALSE_POSITIVE_SUSPECTED",
    "FALSE_NEGATIVE_SUSPECTED",
    "INSUFFICIENT_DATA",
    "RETEST_REQUIRED",
    "EQUIPMENT_ISSUE",
    "PROCESS_EXCEPTION",
    "MANUAL_ENGINEERING_REVIEW",
    "OTHER"
  ],
  "feedback_lifecycle_taxonomy": [
    "RECORDED_ONLY",
    "PENDING_OUTCOME",
    "CONFIRMED",
    "CONTRADICTED",
    "UNRESOLVED"
  ],
  "lifecycle_transitions": {
    "RECORDED_ONLY": [
      "PENDING_OUTCOME",
      "CONFIRMED",
      "CONTRADICTED",
      "UNRESOLVED"
    ],
    "PENDING_OUTCOME": [
      "CONFIRMED",
      "CONTRADICTED",
      "UNRESOLVED"
    ],
    "CONFIRMED": [],
    "CONTRADICTED": [],
    "UNRESOLVED": [
      "PENDING_OUTCOME",
      "CONFIRMED",
      "CONTRADICTED"
    ]
  },
  "required_fields": [
    "disposition_id",
    "trace_id",
    "component_id",
    "lot_id",
    "operator_id",
    "disposition",
    "reason_code",
    "comment",
    "created_at",
    "model_id_at_decision",
    "model_hash_at_decision",
    "anomaly_score_at_decision",
    "prognostic_output_at_decision",
    "decision_at_decision",
    "original_ml_decision",
    "original_ml_probability",
    "source",
    "feedback_status",
    "outcome_status",
    "conflict"
  ],
  "immutability_rules": {
    "original_ml_decision_immutable": true,
    "cannot_overwrite_ml_decision": true,
    "audit_separation": "Operator feedback is recorded as a distinct audit entity; ML decision remains permanently unchanged."
  },
  "conflict_governance": {
    "multiple_operator_support": true,
    "append_only_preservation": true,
    "explicit_conflict_flag": true,
    "prohibit_overwriting_prior_feedback": true,
    "prohibit_automatic_conflict_resolution": true,
    "human_disagreement_is_not_ground_truth": true
  },
  "governance_rules": {
    "default_feedback_status": "RECORDED_ONLY",
    "allowed_feedback_statuses": [
      "RECORDED_ONLY",
      "PENDING_OUTCOME",
      "CONFIRMED",
      "CONTRADICTED",
      "UNRESOLVED",
      "ELIGIBLE_FOR_OFFLINE_REVIEW",
      "REJECTED_GOVERNANCE"
    ],
    "client_controlled_ml_output_policy": "REJECT_CLIENT_ML_SNAPSHOTS",
    "client_controlled_identity_policy": "REJECT_CLIENT_IDENTIFIERS",
    "prohibited_client_fields": [
      "component_id",
      "lot_id",
      "ml_decision_snapshot",
      "original_ml_decision",
      "ml_decision",
      "decision",
      "probability",
      "calibrated_probability",
      "raw_probability",
      "model_hash",
      "model_id",
      "anomaly_score",
      "prognostic_output",
      "ground_truth"
    ],
    "prohibited_client_identity_fields": [
      "component_id",
      "lot_id"
    ],
    "ml_lookup_policy": "BACKEND_AUTHORITATIVE_TRACE_LOOKUP",
    "identity_lookup_policy": "BACKEND_AUTHORITATIVE_IDENTITY_LOOKUP",
    "storage_policy": "APPEND_ONLY_HISTORY",
    "fail_closed_persistence": true,
    "no_automatic_retraining": true,
    "no_threshold_modification": true,
    "no_fusion_weight_modification": true,
    "no_conformal_recalibration": true,
    "test_set_isolation": "Feedback records must never be injected into train, validation_tune, calibration, or test splits."
  },
  "security_rules": {
    "max_comment_length": 1000,
    "allowed_roles": [
      "OPERATOR",
      "ADMIN"
    ],
    "require_trace_id_format": "^[A-Za-z0-9._:-]{1,128}$"
  },
  "disclaimer": "Human dispositions are operator-entered observations and audit signals. They DO NOT represent ground truth labels and DO NOT alter production model state."
}