# Python environment ignores
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Node.js environment ignores
node_modules/

# IDE / System ignores
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Exclude unrelated directories located in the local folder
CyberShield-AI-SOC/
Space_con_Hack_xyz-main/
sementic-search-main/
archive_clientforge/
BACKLOG.md
/data/industry_profiles.js
/data/weights.js

# Exclude large installer binaries and general downloads
*.exe
*.msi
*.zip
*.rar
*.7z

# Exclude personal root documents/media (while preserving project docs)
/*.pdf
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.mp4
/*.pptx
/*.docx
/*.html.html
/generated-image.png

# Allow specific project files at root
!/.gitignore
!/.gitattributes
!/.vercelignore
!/.env.example
!/index.html
!/script.js
!/api.js
!/style.css
!/README.md
!/LICENSE
!/requirements.txt
!/requirements.lock.txt
!/pyproject.toml
!/package.json
!/package-lock.json
!/vercel.json

# Exclude Vercel build and environment files
.vercel/
.env
.env.*
!.env.example
/PREDICTA/

# Runtime & Build Artifacts
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
coverage/
dist/
build/
*.tmp
*.cache
scratch/
scratch*
tmp/
temp/
temp_*
frontend_frozen_checkpoint/
PRE_TYPOGRAPHY_GOLDEN_STATE/
PRE_TYPOGRAPHY_CONFIRMED/
backup_*
build_clean_frontend.py
reports/
